# ==============================================================================
# AI SMART EXPENSE TRACKER — BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================

# Server Network Settings
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas or Local MongoDB)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ai_expense_tracker?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/ai_expense_tracker

# Cryptographic Authentication Security
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long
JWT_EXPIRES_IN=7d

# Google Gemini AI API Configuration (From https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_google_gemini_api_key_here

# File Ingestion Engine Constraints
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,xlsx,xls,csv,txt,json

# System Master Secret for Admin Account Registration
ADMIN_SECRET=your_admin_master_secret_here
