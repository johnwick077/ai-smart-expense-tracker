# AI Smart Expense Tracker — Backend Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai_expense_tracker?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_please_change_in_production_min_32_chars_long
JWT_EXPIRES_IN=7d

# Google Gemini AI API Configuration
GEMINI_API_KEY=your_google_gemini_api_key_here

# File Upload Constraints
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,xlsx,xls,csv,txt,json
